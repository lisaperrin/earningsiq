# Copy to .env and adjust. Every setting in src/earningsiq/config.py can be
# overridden here.

# Required for scripts/01_download_data.py: SEC EDGAR asks automated clients
# to identify themselves with a real contact e-mail address.
EDGAR_USER_AGENT=your.name@example.com

# Optional. "auto" picks Qwen 1.5B if it fits in memory, otherwise TinyLlama.
# Aliases: tinyllama, qwen, phi3, mistral - or any Hugging Face model ID.
# LLM_MODEL=auto
